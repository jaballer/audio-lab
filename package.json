{
  "name": "audio-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Audio Lab: a browser drum sampler and MIDI tools built with Vite, the Web Audio API and Web MIDI",
  "homepage": "https://jaballer.github.io/audio-lab/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaballer/audio-lab.git"
  },
  "bugs": {
    "url": "https://github.com/jaballer/audio-lab/issues"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run test && npm run build",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "tone": "^15.1.22"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
